package components

// Navigation is the shared primary navigation for server-rendered pages.
templ Navigation() {
	<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
			<a href="/" class="flex items-center gap-3 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" aria-label="Pusti Shangar home">
				<img src="/static/images/logo.svg" alt="" class="h-9 w-9" width="36" height="36"/>
				<span class="text-base font-semibold tracking-tight text-slate-900">Pusti Shangar</span>
			</a>

			<nav aria-label="Primary navigation">
				<ul class="flex flex-wrap items-center gap-1 text-sm font-medium text-slate-600">
					<li>
						<a href="/" class="rounded-md px-3 py-2 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
							Home
						</a>
					</li>
					<li>
						<a href="/health" class="rounded-md px-3 py-2 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
							Health
						</a>
					</li>
					<li>
						<a href="/swagger/" class="rounded-md px-3 py-2 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
							API Docs
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</header>
}
