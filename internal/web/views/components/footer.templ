package components

import (
	"strconv"
	"time"
)

// Footer is the shared page footer.
templ Footer() {
	<footer class="border-t border-slate-200 bg-white">
		<div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
			<p>© { strconv.Itoa(time.Now().Year()) } Pusti Shangar. Stage 1 foundation.</p>
			<p>Go · Chi · Templ · HTMX · Tailwind CSS</p>
		</div>
	</footer>
}
