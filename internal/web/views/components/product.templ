package components

import (
	"strconv"

	"github.com/mitesh4000/pushti_sangar/server/internal/service"
)

// ProductCard is the reusable catalogue tile used on the home, listing and
// related-product sections.
templ ProductCard(product service.StoreProduct) {
	<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
		<a href={ templ.URL(product.URL()) } class="relative block aspect-[4/3] overflow-hidden bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-inset">
			<img src={ product.Image } alt={ product.Name } loading="lazy" width="640" height="480" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" onerror="this.onerror=null;this.src='/static/images/product-placeholder.svg'"/>
			<div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
				if product.IsNew {
					<span class="rounded-full bg-slate-950/85 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">New</span>
				}
				if product.HasDiscount {
					<span class="rounded-full bg-amber-400 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-950">-{ strconv.Itoa(product.DiscountPct) }%</span>
				}
				if !product.InStock {
					<span class="rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-rose-700">Sold out</span>
				}
			</div>
		</a>

		<div class="flex flex-1 flex-col p-4 sm:p-5">
			if product.CategoryName != "" {
				<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-emerald-700">{ product.CategoryName }</p>
			}
			<h3 class="mt-1.5 text-base font-semibold leading-6 text-slate-950">
				<a href={ templ.URL(product.URL()) } class="rounded-sm transition hover:text-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
					{ product.Name }
				</a>
			</h3>
			if product.Description != "" {
				<p class="mt-1.5 line-clamp-2 text-sm leading-6 text-slate-600">{ truncateText(product.Description, 110) }</p>
			}

			<div class="mt-auto pt-4">
				<div class="flex items-end justify-between gap-3">
					<div>
						<p class="text-lg font-bold tracking-tight text-slate-950">{ service.FormatMoney(product.Price) }</p>
						if product.HasDiscount {
							<p class="text-xs font-medium text-slate-400 line-through">{ service.FormatMoney(product.OriginalPrice) }</p>
						}
					</div>
					<p class="text-xs font-semibold text-slate-500">{ stockLabel(product.Stock, product.StockTracked) }</p>
				</div>

				if product.InStock {
					<form hx-post="/cart/items" hx-target="#cart-feedback" hx-swap="innerHTML" hx-indicator="#htmx-indicator" class="mt-3">
						<input type="hidden" name="productId" value={ product.ID }/>
						<input type="hidden" name="quantity" value="1"/>
						<button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 7H6.2"/>
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v5M9.5 11.5h5"/>
							</svg>
							Add to cart
						</button>
					</form>
				} else {
					<button type="button" disabled class="mt-3 inline-flex w-full cursor-not-allowed items-center justify-center rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-500">
						Out of stock
					</button>
				}
			</div>
		</div>
	</article>
}

// ProductGrid renders a responsive product collection.
templ ProductGrid(products []service.StoreProduct) {
	<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		for _, product := range products {
			@ProductCard(product)
		}
	</div>
}

// ProductsEmpty is the honest empty state used when the catalogue has no
// matching rows. It never invents demo products.
templ ProductsEmpty(filtered bool) {
	<div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
		<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
			<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M6.5 7l1 12h9l1-12M9 7V5a3 3 0 0 1 6 0v2"/>
			</svg>
		</div>
		<h2 class="mt-4 text-lg font-semibold text-slate-950">
			if filtered {
				No products match those filters
			} else {
				The catalogue is being prepared
			}
		</h2>
		<p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600">
			if filtered {
				Try a different search term, choose another collection, or clear the filters to see everything.
			} else {
				New pieces will appear here as soon as they are published. There is nothing to buy yet.
			}
		</p>
		if filtered {
			<a href="/products" class="mt-6 inline-flex items-center justify-center rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">Clear filters</a>
		}
	</div>
}

// ProductResults is the HTMX-swappable body of the listing page.
templ ProductResults(result service.ProductResult) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<p class="text-sm text-slate-600">
			if result.Total == 0 {
				No products found
			} else {
				Showing <span class="font-semibold text-slate-950">{ strconv.Itoa(result.RangeStart()) }–{ strconv.Itoa(result.RangeEnd()) }</span> of <span class="font-semibold text-slate-950">{ strconv.Itoa(result.Total) }</span>
			}
			if result.Query.Q != "" {
				<span> for “{ result.Query.Q }”</span>
			}
		</p>
		if result.PageCount > 1 {
			<p class="text-sm font-medium text-slate-500">Page { strconv.Itoa(result.Page) } of { strconv.Itoa(result.PageCount) }</p>
		}
	</div>

	<div class="mt-5">
		if len(result.Products) == 0 {
			@ProductsEmpty(result.Query.Q != "" || result.Query.Category != "")
		} else {
			@ProductGrid(result.Products)
		}
	</div>

	@Pagination(result)
}

// Pagination keeps the active query string and updates only the results grid
// for HTMX requests. The same links work as normal browser navigations.
templ Pagination(result service.ProductResult) {
	if result.PageCount > 1 {
		<nav class="mt-8 flex items-center justify-between gap-3" aria-label="Product pagination">
			if result.HasPrevious() {
				<a href={ templ.URL(result.PageURL(result.Page - 1)) } hx-get={ result.PageURL(result.Page - 1) } hx-target="#product-results" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#htmx-indicator" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
					← Previous
				</a>
			} else {
				<span class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-400">← Previous</span>
			}

			<span class="text-sm font-medium text-slate-600">{ strconv.Itoa(result.Page) } / { strconv.Itoa(result.PageCount) }</span>

			if result.HasNext() {
				<a href={ templ.URL(result.PageURL(result.Page + 1)) } hx-get={ result.PageURL(result.Page + 1) } hx-target="#product-results" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#htmx-indicator" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
					Next →
				</a>
			} else {
				<span class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-400">Next →</span>
			}
		</nav>
	}
}
