package layouts

import (
	templpkg "github.com/a-h/templ"
	"github.com/mitesh4000/pushti_sangar/server/internal/web/views/components"
)

// Base is the document shell used by every full page.
templ Base(title string, chrome Chrome, content templpkg.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-slate-50">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Pusti Shangar — considered clothing and craft for everyday wear."/>
			<meta name="htmx-config" content={ htmxConfig() }/>
			<meta name="csrf-token" content={ chrome.CSRFToken }/>
			<title>{ title } · Pusti Shangar</title>
			<link rel="icon" type="image/svg+xml" href="/static/images/logo.svg"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
		</head>
		<body class="flex min-h-full flex-col bg-slate-50 text-slate-900 antialiased" hx-headers={ htmxHeaders(chrome.CSRFToken) }>
			<a href="#main-content" class="sr-only rounded-md bg-white px-4 py-2 text-sm font-semibold text-slate-900 shadow focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50">
				Skip to content
			</a>

			@components.Header(chrome.CartCount, chrome.Path)

			<div id="htmx-indicator" class="htmx-indicator fixed right-4 top-20 z-50 items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-lg" role="status" aria-live="polite">
				<span class="inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true"></span>
				Working…
			</div>

			<div id="cart-feedback" class="mx-auto w-full max-w-7xl px-4 pt-4 sm:px-6 lg:px-8" role="status" aria-live="polite"></div>

			<main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
				@content
			</main>

			@components.Footer()
		</body>
	</html>
}
