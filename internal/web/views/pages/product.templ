package pages

import (
	"strconv"

	"github.com/mitesh4000/pushti_sangar/server/internal/service"
	"github.com/mitesh4000/pushti_sangar/server/internal/web/views/components"
)

// ProductDetail is the data required by the product page.
type ProductDetail struct {
	Product  service.StoreProduct
	Variants []service.StoreProduct
	Related  []service.StoreProduct
}

// Product renders one catalogue item with real price, stock and gallery data.
templ Product(detail ProductDetail) {
	<nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-500" aria-label="Breadcrumb">
		<a href="/" class="rounded transition hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Home</a>
		<span aria-hidden="true">/</span>
		<a href="/products" class="rounded transition hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Shop</a>
		if detail.Product.CategoryName != "" {
			<span aria-hidden="true">/</span>
			<a href={ templ.URL("/products?category=" + detail.Product.CategoryID) } class="rounded transition hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">{ detail.Product.CategoryName }</a>
		}
		<span aria-hidden="true">/</span>
		<span class="truncate text-slate-700">{ detail.Product.Name }</span>
	</nav>

	<section class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] lg:items-start">
		<div>
			if len(detail.Product.Images) > 1 {
				<div class="grid grid-cols-2 gap-2">
					for index, image := range galleryImages(detail.Product.Images) {
						<div class={ galleryTileClass(index) }>
							<img src={ image } alt={ detail.Product.Name } loading={ galleryLoading(index) } width="800" height="800" class="h-full w-full object-cover" onerror="this.onerror=null;this.src='/static/images/product-placeholder.svg'"/>
						</div>
					}
				</div>
			} else {
				<div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
					<img src={ detail.Product.Image } alt={ detail.Product.Name } width="900" height="900" class="aspect-square h-full w-full object-cover" onerror="this.onerror=null;this.src='/static/images/product-placeholder.svg'"/>
				</div>
			}
		</div>

		<div class="lg:sticky lg:top-24">
			<div class="flex flex-wrap items-center gap-2">
				if detail.Product.CategoryName != "" {
					<a href={ templ.URL("/products?category=" + detail.Product.CategoryID) } class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-emerald-700 transition hover:bg-emerald-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">{ detail.Product.CategoryName }</a>
				}
				if detail.Product.IsNew {
					<span class="rounded-full bg-slate-950 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-white">New</span>
				}
			</div>

			<h1 class="mt-4 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{ detail.Product.Name }</h1>

			<div class="mt-4 flex flex-wrap items-end gap-3">
				<p class="text-3xl font-black tracking-tight text-slate-950">{ service.FormatMoney(detail.Product.Price) }</p>
				if detail.Product.HasDiscount {
					<p class="pb-1 text-base font-medium text-slate-400 line-through">{ service.FormatMoney(detail.Product.OriginalPrice) }</p>
					<span class="mb-1 rounded-full bg-amber-400 px-2.5 py-1 text-xs font-bold text-amber-950">Save { strconv.Itoa(detail.Product.DiscountPct) }%</span>
				}
			</div>

			<div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
				if detail.Product.InStock {
					<span class="inline-flex items-center gap-2 font-semibold text-emerald-700">
						<span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
						{ stockText(detail.Product) }
					</span>
				} else {
					<span class="inline-flex items-center gap-2 font-semibold text-rose-700">
						<span class="h-2 w-2 rounded-full bg-rose-500" aria-hidden="true"></span>
						Out of stock
					</span>
				}
				if detail.Product.SKU != "" {
					<span class="text-slate-400" aria-hidden="true">·</span>
					<span class="text-slate-500">SKU { detail.Product.SKU }</span>
				}
			</div>

			if detail.Product.Description != "" {
				<div class="mt-6 space-y-3 text-base leading-7 text-slate-600">
					for _, paragraph := range paragraphs(detail.Product.Description) {
						<p>{ paragraph }</p>
					}
				</div>
			}

			if detail.Product.InStock {
				<form hx-post="/cart/items" hx-target="#cart-feedback" hx-swap="innerHTML" hx-indicator="#htmx-indicator" class="mt-7 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
					<input type="hidden" name="productId" value={ detail.Product.ID }/>
					<div class="flex flex-wrap items-end gap-3">
						<label class="block">
							<span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Quantity</span>
							<input type="number" name="quantity" value="1" min="1" max={ strconv.Itoa(quantityMax(detail.Product)) } class="w-24 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30"/>
						</label>
						<button type="submit" class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-slate-950 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 7H6.2"/>
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v5M9.5 11.5h5"/>
							</svg>
							Add to cart
						</button>
					</div>
					<p class="mt-3 text-xs leading-5 text-slate-500">Stock and price are checked again on the server when you add this item.</p>
				</form>
			} else {
				<div class="mt-7 rounded-2xl border border-slate-200 bg-slate-50 p-5">
					<p class="text-sm font-semibold text-slate-700">This piece is currently out of stock.</p>
					<a href="/products" class="mt-3 inline-flex items-center rounded-lg text-sm font-semibold text-emerald-700 transition hover:text-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Browse other products →</a>
				</div>
			}

			if detail.Product.Material != "" || detail.Product.Color != "" || detail.Product.Size != "" || detail.Product.ShippingCharge > 0 {
				<dl class="mt-6 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white text-sm">
					if detail.Product.Material != "" {
						<div class="flex items-center justify-between gap-4 px-4 py-3">
							<dt class="font-medium text-slate-500">Material</dt>
							<dd class="text-right font-semibold text-slate-900">{ detail.Product.Material }</dd>
						</div>
					}
					if detail.Product.Color != "" {
						<div class="flex items-center justify-between gap-4 px-4 py-3">
							<dt class="font-medium text-slate-500">Colour</dt>
							<dd class="text-right font-semibold text-slate-900">{ detail.Product.Color }</dd>
						</div>
					}
					if detail.Product.Size != "" {
						<div class="flex items-center justify-between gap-4 px-4 py-3">
							<dt class="font-medium text-slate-500">Size</dt>
							<dd class="text-right font-semibold text-slate-900">{ detail.Product.Size }</dd>
						</div>
					}
					if detail.Product.ShippingCharge > 0 {
						<div class="flex items-center justify-between gap-4 px-4 py-3">
							<dt class="font-medium text-slate-500">Shipping</dt>
							<dd class="text-right font-semibold text-slate-900">{ service.FormatMoney(detail.Product.ShippingCharge) }</dd>
						</div>
					}
				</dl>
			}

			if len(detail.Product.Tags) > 0 {
				<ul class="mt-5 flex flex-wrap gap-2" aria-label="Product tags">
					for _, tag := range detail.Product.Tags {
						<li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{ tag }</li>
					}
				</ul>
			}
		</div>
	</section>

	if len(detail.Variants) > 0 {
		<section class="mt-12" aria-labelledby="variants-heading">
			<h2 id="variants-heading" class="text-2xl font-bold tracking-tight text-slate-950">Other options</h2>
			<div class="mt-5">
				@components.ProductGrid(detail.Variants)
			</div>
		</section>
	}

	if len(detail.Related) > 0 {
		<section class="mt-12" aria-labelledby="related-heading">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 id="related-heading" class="text-2xl font-bold tracking-tight text-slate-950">You may also like</h2>
				<a href="/products" class="rounded-lg text-sm font-semibold text-emerald-700 transition hover:text-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">View all →</a>
			</div>
			<div class="mt-5">
				@components.ProductGrid(detail.Related)
			</div>
		</section>
	}
}

func stockText(product service.StoreProduct) string {
	if !product.StockTracked {
		return "Available"
	}
	if product.Stock < 10 {
		return "Only " + strconv.Itoa(product.Stock) + " left"
	}
	return "In stock"
}

func galleryTileClass(index int) string {
	base := "overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
	if index == 0 {
		return base + " col-span-2 aspect-[16/10]"
	}
	return base + " aspect-square"
}

func galleryLoading(index int) string {
	if index == 0 {
		return "eager"
	}
	return "lazy"
}
