package pages

import (
	"github.com/mitesh4000/pushti_sangar/server/internal/service"
	"github.com/mitesh4000/pushti_sangar/server/internal/web/views/components"
)

// Products is the full product listing page. The filter form and pagination
// both target #product-results, so HTMX swaps only the results and keeps the
// URL in sync without a client-side router.
templ Products(result service.ProductResult, categories []service.StoreCategory) {
	<header class="flex flex-wrap items-end justify-between gap-4">
		<div>
			<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700">Catalogue</p>
			<h1 class="mt-1 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Shop all</h1>
			<p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Filter, sort and paginate on the server. Every result is read from the existing product catalogue.</p>
		</div>
		<a href="/cart" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">Go to cart</a>
	</header>

	<form action="/products" method="get" hx-get="/products" hx-target="#product-results" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#htmx-indicator" class="mt-7 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
		<div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_12rem_12rem_auto]">
			<label class="block">
				<span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Search</span>
				<span class="relative block">
					<svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<circle cx="11" cy="11" r="6.5"/>
						<path stroke-linecap="round" d="m16 16 4.5 4.5"/>
					</svg>
					<input type="search" name="q" value={ result.Query.Q } placeholder="Search products…" class="w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30"/>
				</span>
			</label>

			<label class="block">
				<span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Category</span>
				<select name="category" hx-get="/products" hx-target="#product-results" hx-include="closest form" hx-push-url="true" hx-trigger="change" hx-indicator="#htmx-indicator" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
					<option value="">All collections</option>
					for _, category := range categories {
						if result.Query.Category == category.ID {
							<option value={ category.ID } selected>{ category.Name }</option>
						} else {
							<option value={ category.ID }>{ category.Name }</option>
						}
					}
				</select>
			</label>

			<label class="block">
				<span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Sort</span>
				<select name="sort" hx-get="/products" hx-target="#product-results" hx-include="closest form" hx-push-url="true" hx-trigger="change" hx-indicator="#htmx-indicator" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
					if result.Query.Sort == "newest" {
						<option value="newest" selected>Newest</option>
					} else {
						<option value="newest">Newest</option>
					}
					if result.Query.Sort == "popular" {
						<option value="popular" selected>Popular</option>
					} else {
						<option value="popular">Popular</option>
					}
					if result.Query.Sort == "price-asc" {
						<option value="price-asc" selected>Price: low to high</option>
					} else {
						<option value="price-asc">Price: low to high</option>
					}
					if result.Query.Sort == "price-desc" {
						<option value="price-desc" selected>Price: high to low</option>
					} else {
						<option value="price-desc">Price: high to low</option>
					}
					if result.Query.Sort == "name-asc" {
						<option value="name-asc" selected>Name: A–Z</option>
					} else {
						<option value="name-asc">Name: A–Z</option>
					}
					if result.Query.Sort == "name-desc" {
						<option value="name-desc" selected>Name: Z–A</option>
					} else {
						<option value="name-desc">Name: Z–A</option>
					}
				</select>
			</label>

			<div class="flex items-end gap-2">
				<button type="submit" class="inline-flex h-[42px] items-center justify-center rounded-xl bg-slate-950 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">Apply</button>
				if result.Query.Q != "" || result.Query.Category != "" || result.Query.Sort != "newest" {
					<a href="/products" class="inline-flex h-[42px] items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Clear</a>
				}
			</div>
		</div>
	</form>

	<div id="product-results" class="mt-6" aria-live="polite">
		@components.ProductResults(result)
	</div>
}
