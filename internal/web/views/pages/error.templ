package pages

import (
	"net/http"
	"strconv"
)

// Error is a user-safe error page. It never receives internal error details.
templ Error(status int, message string) {
	<section class="mx-auto max-w-xl py-16 text-center">
		<p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Error { strconv.Itoa(status) }</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{ http.StatusText(status) }</h1>
		<p class="mt-4 text-base leading-7 text-slate-600">{ message }</p>
		<a href="/" class="mt-8 inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
			Back to home
		</a>
	</section>
}
