package pages

import (
	"strconv"

	"github.com/mitesh4000/pushti_sangar/server/internal/service"
	"github.com/mitesh4000/pushti_sangar/server/internal/web/views/components"
)

// HomeData contains only real rows read from the existing catalogue and CMS
// tables. Empty slices produce honest empty states rather than demo products.
type HomeData struct {
	Banners     []service.StoreBanner
	Categories  []service.StoreCategory
	Featured    []service.StoreProduct
	NewArrivals []service.StoreProduct
}

// Home is the storefront landing page.
templ Home(data HomeData) {
	<section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
		<div class="grid lg:grid-cols-[1.05fr_0.95fr]">
			<div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
				<p class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700">
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
					Pusti Shangar
				</p>
				if len(data.Banners) > 0 {
					<h1 class="mt-5 max-w-xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
						{ bannerHeadline(data.Banners[0]) }
					</h1>
					<p class="mt-5 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
						{ bannerCopy(data.Banners[0]) }
					</p>
				} else {
					<h1 class="mt-5 max-w-xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
						Considered pieces for everyday rituals.
					</h1>
					<p class="mt-5 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
						Explore the catalogue as it is published. Every product, price and stock level comes directly from the server.
					</p>
				}
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a href="/products" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
						Shop the collection
						<span aria-hidden="true">→</span>
					</a>
					<a href="/cart" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
						View cart
					</a>
				</div>
				<div class="mt-8 grid max-w-lg grid-cols-3 gap-3 border-t border-slate-200 pt-6 text-xs text-slate-600">
					<div>
						<p class="font-bold text-slate-950">Server-side</p>
						<p class="mt-1 leading-5">Cart and totals</p>
					</div>
					<div>
						<p class="font-bold text-slate-950">Live stock</p>
						<p class="mt-1 leading-5">Resolved per request</p>
					</div>
					<div>
						<p class="font-bold text-slate-950">HTMX</p>
						<p class="mt-1 leading-5">Fast partial updates</p>
					</div>
				</div>
			</div>

			<div class="relative min-h-64 overflow-hidden bg-gradient-to-br from-emerald-100 via-amber-50 to-rose-100">
				if len(data.Banners) > 0 {
					<img src={ data.Banners[0].Image } alt={ bannerHeadline(data.Banners[0]) } class="h-full min-h-72 w-full object-cover" onerror="this.onerror=null;this.src='/static/images/banner-placeholder.svg'"/>
				} else {
					<div class="flex h-full min-h-72 flex-col items-center justify-center p-10 text-center">
						<img src="/static/images/banner-placeholder.svg" alt="" class="h-44 w-auto drop-shadow-sm" width="360" height="240"/>
						<p class="mt-6 max-w-xs text-sm font-medium leading-6 text-emerald-950/70">The collection is being prepared. Published products will appear here automatically.</p>
					</div>
				}
			</div>
		</div>
	</section>

	if len(data.Categories) > 0 {
		<section class="mt-12" aria-labelledby="collections-heading">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700">Browse</p>
					<h2 id="collections-heading" class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Collections</h2>
				</div>
				<a href="/products" class="rounded-lg text-sm font-semibold text-emerald-700 transition hover:text-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">View all products →</a>
			</div>
			<div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
				for _, category := range data.Categories {
					<a href={ templ.URL(category.URL()) } class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
						<div class="aspect-[5/3] overflow-hidden bg-slate-100">
							<img src={ category.Image } alt="" loading="lazy" width="400" height="240" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" onerror="this.onerror=null;this.src='/static/images/category-placeholder.svg'"/>
						</div>
						<div class="p-4">
							<h3 class="text-sm font-bold text-slate-950">{ category.Name }</h3>
							<p class="mt-1 text-xs font-medium text-slate-500">{ strconv.Itoa(category.ProductCount) } products</p>
						</div>
					</a>
				}
			</div>
		</section>
	}

	if len(data.Featured) > 0 {
		<section class="mt-12" aria-labelledby="featured-heading">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700">Curated</p>
					<h2 id="featured-heading" class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Popular right now</h2>
				</div>
				<a href="/products?sort=popular" class="rounded-lg text-sm font-semibold text-emerald-700 transition hover:text-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">See popular →</a>
			</div>
			<div class="mt-5">
				@components.ProductGrid(data.Featured)
			</div>
		</section>
	}

	if len(data.NewArrivals) > 0 {
		<section class="mt-12" aria-labelledby="new-heading">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700">Just in</p>
					<h2 id="new-heading" class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">New arrivals</h2>
				</div>
				<a href="/products?sort=newest" class="rounded-lg text-sm font-semibold text-emerald-700 transition hover:text-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">See newest →</a>
			</div>
			<div class="mt-5">
				@components.ProductGrid(data.NewArrivals)
			</div>
		</section>
	}

	if len(data.Featured) == 0 && len(data.NewArrivals) == 0 {
		<section class="mt-12" aria-labelledby="empty-heading">
			<h2 id="empty-heading" class="sr-only">Catalogue status</h2>
			@components.ProductsEmpty(false)
		</section>
	}
}

func bannerHeadline(banner service.StoreBanner) string {
	if banner.Title != "" {
		return banner.Title
	}
	if banner.Text != "" {
		return banner.Text
	}
	return "Considered pieces for everyday rituals."
}

func bannerCopy(banner service.StoreBanner) string {
	if banner.Description != "" {
		return banner.Description
	}
	return "Explore the catalogue as it is published. Every product, price and stock level comes directly from the server."
}
