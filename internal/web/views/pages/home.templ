package pages

// Home is a placeholder homepage for Stage 1. It proves the rendering stack
// works without implementing any real commerce features yet.
templ Home() {
	<section class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
		<div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
			<span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700">
				<span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
				Stage 1 foundation
			</span>
			<h1 class="mt-5 max-w-2xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
				Server-rendered commerce, without the JavaScript sprawl.
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
				The existing Chi API is intact. Templ renders HTML, HTMX handles small interactions, and Tailwind compiles locally — no Node.js required.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href="#htmx-demo" class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
					Try the HTMX demo
				</a>
				<a href="/swagger/" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
					Explore the API
				</a>
			</div>
		</div>

		<aside class="rounded-3xl border border-slate-200 bg-slate-900 p-8 text-slate-100 shadow-sm">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-300">What is wired up</h2>
			<ul class="mt-5 space-y-4 text-sm leading-6">
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
					<span><strong class="font-semibold text-white">Chi</strong> keeps serving every existing JSON endpoint.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
					<span><strong class="font-semibold text-white">Templ</strong> renders reusable layouts, components and pages.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
					<span><strong class="font-semibold text-white">HTMX</strong> is served locally from the embedded binary.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
					<span><strong class="font-semibold text-white">Tailwind</strong> is compiled by the standalone CLI.</span>
				</li>
			</ul>
		</aside>
	</section>

	<section id="htmx-demo" class="mt-10 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
			<div class="max-w-2xl">
				<h2 class="text-2xl font-semibold tracking-tight text-slate-950">HTMX round trip</h2>
				<p class="mt-3 text-base leading-7 text-slate-600">
					This button sends an <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm font-medium text-slate-800">HX-Request</code> GET to Go. The handler returns a Templ-rendered fragment, which HTMX swaps into the panel below.
				</p>
			</div>
			<button type="button" hx-get="/fragments/server-message" hx-target="#server-message" hx-swap="innerHTML" hx-indicator="#htmx-indicator" class="inline-flex shrink-0 items-center justify-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2">
				Load server message
			</button>
		</div>
		<div id="server-message" class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5" aria-live="polite">
			<p class="text-sm text-slate-500">No message loaded yet. Click the button to request one from the server.</p>
		</div>
	</section>

	<section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
			<h2 class="text-base font-semibold text-slate-950">Shared foundation</h2>
			<p class="mt-2 text-sm leading-6 text-slate-600">HTML handlers and JSON handlers use the same database handle, configuration and Chi middleware stack.</p>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
			<h2 class="text-base font-semibold text-slate-950">Local assets</h2>
			<p class="mt-2 text-sm leading-6 text-slate-600">Compiled CSS and HTMX are embedded with <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-800">go:embed</code> and served by Go.</p>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
			<h2 class="text-base font-semibold text-slate-950">Ready for Stage 2</h2>
			<p class="mt-2 text-sm leading-6 text-slate-600">The layout, renderer and route registration are reusable for the storefront and admin panel.</p>
		</div>
	</section>
}
