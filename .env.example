# Application
PORT=5000
# development | production (production enables strict validation)
ENV=development

# SQLite path. Use an absolute path such as /data/app.db in production.
DATABASE_URL=./data/dev.db

# Required in production. Generate a long random value (32+ characters) and
# never commit it. The development default is intentionally weak.
JWT_SECRET=change-me-development-only

# Existing frontend origins (used by the JSON API's CORS middleware).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Explicit comma-separated allow-list. Required in production; wildcards and
# localhost origins are rejected there.
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Auth failure HTTP status. "legacy" keeps the original HTTP 200 +
# {"success":false} contract. "strict" returns 401/403 and is the production
# default. Set AUTH_STATUS=strict while migrating clients to real status codes.
# AUTH_STATUS=legacy

# Mark auth cookies Secure. Defaults to true in production, false in dev.
# COOKIE_SECURE=true

# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=false

# Persistent user uploads (not embedded in the binary).
UPLOADS_DIR=./uploads

# Payment callback verification. Both values must be set together. The provider
# signs "orderId|providerReference|amount" with HMAC-SHA256 using this secret.
# When unset, POST /api/payment fails closed with HTTP 503.
# PAYMENT_PROVIDER=stripe
# PAYMENT_SECRET=replace-with-a-16-plus-character-shared-secret

# Seed passwords. In production the seed command refuses to run unless these
# are set. Development falls back to documented demo passwords.
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_USER_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# Optional email delivery configuration.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
