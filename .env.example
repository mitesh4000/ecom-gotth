# Application
PORT=5000
ENV=development

# SQLite path. Use an absolute path such as /data/app.db in production.
DATABASE_URL=./data/dev.db

# Required in production. Generate a long random value and never commit it.
JWT_SECRET=change-me-development-only

# Existing frontend origins (used by the JSON API's CORS middleware).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Persistent user uploads (not embedded in the binary).
UPLOADS_DIR=./uploads

# Optional email delivery configuration.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
